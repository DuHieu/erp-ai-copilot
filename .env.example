ERP_AI_VERSION=latest
OLLAMA_MODEL=qwen3
EMBEDDING_MODEL=BAAI/bge-m3

API_PORT=5000
WEB_PORT=5001
OLLAMA_PORT=11434
DOCUMENT_PARSER_PORT=8000
EMBEDDING_PORT=8010

QDRANT_COLLECTION=erp_knowledge_chunks
KNOWLEDGE_SEARCH_TOP_K=5
KNOWLEDGE_SEARCH_MIN_SCORE=0.35

# Grounded RAG chat settings
RAG_TOP_K=6
RAG_MIN_SCORE=0.35
RAG_MAX_SOURCES=5
RAG_MAX_CONTEXT_CHARACTERS=14000
RAG_MAX_CHUNK_CHARACTERS=3500
RAG_MAX_CITATION_SNIPPET_CHARACTERS=300
RAG_INCLUDE_ADJACENT_CHUNKS=true
RAG_MAX_ADJACENT_CHUNKS=1
RAG_MAX_CONVERSATION_TURNS=6
RAG_TEMPERATURE=0.1
RAG_MAX_OUTPUT_TOKENS=800

ASPNETCORE_ENVIRONMENT=Development

# Optional API key protection for /api/* endpoints.
# Keep disabled for local demos; enable before exposing the API beyond localhost.
API_REQUIRE_API_KEY=false
API_KEY=
API_KEY_USER_ID=demo-user
