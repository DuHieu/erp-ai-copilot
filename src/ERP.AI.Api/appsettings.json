{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=samples/database/erp-demo.db"
  },
  "AI": {
    "Provider": "Ollama",
    "Model": "qwen3",
    "Endpoint": "http://localhost:11434"
  },
  "Security": {
    "RequireApiKey": false,
    "UseDemoPermissions": true,
    "DemoUserId": "demo-user",
    "DemoRoles": [
      "Finance",
      "Manager"
    ],
    "Permissions": [
      "Accounting.View",
      "Sales.View",
      "Inventory.View",
      "Project.View"
    ]
  },
  "Rag": {
    "TopK": 6,
    "MinimumScore": 0.35,
    "MaximumSources": 5,
    "MaxContextCharacters": 14000,
    "MaxChunkCharacters": 3500,
    "MaxCitationSnippetCharacters": 300,
    "IncludeAdjacentChunks": true,
    "MaxAdjacentChunks": 1,
    "MaxConversationTurns": 6,
    "Temperature": 0.1,
    "MaxOutputTokens": 800
  }
}
